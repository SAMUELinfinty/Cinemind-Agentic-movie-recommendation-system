# CineMind Agent Service — environment example (placeholders only, safe to commit).
# Copy to .env for local development. Never commit real keys.

# Service port (must stay 8001 per PROJECT_PLAN.md)
PORT=8001

# OpenRouter (OpenAI-compatible) credentials — placeholders only
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
OPENROUTER_MODEL=openrouter/model-id
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shared internal key (placeholder only). Required for POST /chat.
INTERNAL_API_KEY=change-me-in-local-env

# Private movies service (called server-side with X-Internal-Key)
MOVIES_SERVICE_URL=http://localhost:8002

# Express API for approved user endpoints (profile/watchlist/ratings).
# Called server-side with the caller's Bearer token (see user_token).
EXPRESS_API_URL=http://localhost:5000

# Timeouts (seconds)
LLM_TIMEOUT_S=30.0
MOVIES_TIMEOUT_S=10.0
