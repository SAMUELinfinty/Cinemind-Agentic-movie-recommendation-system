# CineMind Express API — environment example (placeholders only, safe to commit).
# Copy to .env for local development. Never commit real secrets.

# Public gateway port (must stay 5000 per PROJECT_PLAN.md)
PORT=5000

# MongoDB connection string (local placeholder)
MONGODB_URI=mongodb://localhost:27017/cinemind

# JWT signing secret (placeholder only — set a long random value in .env)
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime
JWT_EXPIRES_IN=7d

# Shared internal key for service-to-service auth (placeholder only)
INTERNAL_API_KEY=change-me-in-local-env

# Private internal services (never exposed to the browser)
MOVIES_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8001
# Timeout (ms) for Express -> agent chat calls
AGENT_TIMEOUT_MS=45000
# Timeout (ms) for Express -> movies reads (proxy + chat cards)
MOVIES_TIMEOUT_MS=15000
# Optional DNS override for machines where Node's resolver fails (comma-separated)
DNS_SERVERS=8.8.8.8,1.1.1.1
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173
