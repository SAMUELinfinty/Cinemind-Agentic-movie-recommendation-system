# CineMind Movies Service — environment example (placeholders only, safe to commit)
# Copy to .env for local development. Never put real secrets in this file.

# MongoDB connection string (local default shown as placeholder)
MONGODB_URI=mongodb://localhost:27017
# MongoDB database name
MONGODB_DB=cinemind
# MongoDB collection for movies
MONGODB_COLLECTION=movies
# Service port (must stay 8002 per PROJECT_PLAN.md)
PORT=8002
# Shared internal token for service-to-service auth (placeholder only)
INTERNAL_API_KEY=change-me-in-local-env
